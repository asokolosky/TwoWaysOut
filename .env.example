# Copy to .env and fill in. .env is gitignored.

# Claude API key for AI listing analysis (optional; the app falls back to rule-based analysis)
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_SECONDS=30

# Shared password for the town dashboard
DASHBOARD_PASSWORD=

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Always mark the town session cookie Secure (use when a proxy terminates TLS and uvicorn
# isn't run with --proxy-headers)
# FORCE_SECURE_COOKIES=true

# Optional, build time only: Data Commons (U.S. Census) key for the area context step in
# scripts/build_data.sh. Not read by the running app. For Docker builds pass it as a BuildKit
# secret (see docs/DEPLOY.md), never as a build arg. Leave empty to skip area context.
# DATACOMMONS_API_KEY=
